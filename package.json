{
  "name": "webgauge",
  "version": "1.0.0",
  "description": "CLI that checks a website for availability, security, SEO and accessibility and reports a score 0-100.",
  "license": "MIT",
  "author": "Hampus Olsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamol355/WebGauge.git"
  },
  "homepage": "https://github.com/hamol355/WebGauge#readme",
  "bugs": {
    "url": "https://github.com/hamol355/WebGauge/issues"
  },
  "keywords": [
    "cli",
    "website",
    "audit",
    "security",
    "seo",
    "accessibility",
    "wcag",
    "headers",
    "score"
  ],
  "type": "module",
  "bin": {
